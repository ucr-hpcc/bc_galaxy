# Export the module function if it exists
[[ $(type -t module) == "function" ]] && export -f module


#Set working directory
<%

working_dir = Pathname.new(context.working_dir)

# Ensure that galaxy-server always starts up in either a user defined directory or the home directory.
if ! working_dir.exist?
    working_dir = Pathname.new(ENV['HOME'])
elsif working_dir.file?
    working_dir = working_dir.parent
end

%>


# Find available port to run server on
export port=$(find_port)

# Ensure only required galaxy modules are loaded
module purge -f
module load galaxy
module load <%= context.modules %>

# Define Galaxy Variables
export GALAXY_CONFIG_FILE="${PWD}/galaxy.yml"
export RUNNER="<%= context.job_runner %>"
export DATAROOT="<%= working_dir.to_s %>"/.galaxy


ENVIRONMENT_MAPPING_FILE_PATH="${DATAROOT}/config/environment_modules_mapping.yml"
ENVIRONMENT_MODULES_FILE_PATH="${DATAROOT}/tools/helpers"
ENVIRONMENT_MODULES_CONFIG_FILE_PATH="${DATAROOT}/config/helper_tools.xml"
WEBHOOKS_DIR=${GALAXY_ROOT_DIR}/config/plugins/webhooks/local_webhooks


if [[ $RUNNER == "slurm" ]]; then
  WEBHOOKS_DIR=${GALAXY_ROOT_DIR}/config/plugins/webhooks/local_webhooks,${GALAXY_ROOT_DIR}/config/plugins/webhooks/slurm_webhooks
(
umask 077
cat > "${PWD}/hpcc_tools.xml" << EOL
<?xml version="1.0"?>
<toolbox monitor="false">
  <section id="hpcc_tools" name="UCR HPCC Tools">
        <tool file="${GALAXY_ROOT_DIR}/tools/hpcc/workflow_step_config.xml" />
  	<tool file="${GALAXY_ROOT_DIR}/tools/hpcc/run_module.xml" />
  </section>
</toolbox>
EOL
)
else
(
umask 077
cat > "${PWD}/hpcc_tools.xml" << EOL
<?xml version="1.0"?>
<toolbox monitor="false">
  <section id="hpcc_tools" name="UCR HPCC Tools">
  	<tool file="${GALAXY_ROOT_DIR}/tools/hpcc/run_module.xml" />
        <tool file="${GALAXY_ROOT_DIR}/tools/hpcc/workflow_downloader.xml" />
  </section>
</toolbox>
EOL
)
fi

# Generate Galaxy job configuration file
(
umask 077
cat > "${PWD}/job_conf.xml" << EOL
<?xml version="1.0"?>
<job_conf>
    <plugins>
        <plugin id="local" type="runner" load="galaxy.jobs.runners.local:LocalJobRunner"/>
        <plugin id="slurm" type="runner" load="galaxy.jobs.runners.slurm:SlurmJobRunner"/>
        <plugin id="dynamic" type="runner" >
          <param id="runner"><%= context.job_runner %></param>
          <param id="rules_module">galaxy.jobs.rules</param>
        </plugin>
    </plugins>
    <destinations default="dynamic">
        <destination id="dynamic" runner="dynamic">
            <param id="type">python</param>
            <param id="function">dynamic_cores_time</param>
        </destination>
        <destination id="slurm" runner="slurm">
            <env id="HPCC_MODULES">${HPCC_MODULES}</env>
            <env id="DATAROOT">${DATAROOT}</env>
            <env id="port">${port}</env>
            <env exec="module load workspace/scratch"></env>
        </destination>
        <destination id="local" runner="local">
            <env id="HPCC_MODULES">${HPCC_MODULES}</env>
            <env id="DATAROOT">${DATAROOT}</env>
            <env id="port">${port}</env>
            <param id="tmp_dir">${SCRATCH}</param>
            <param id="local_slots"><%= context.num_cores %></param>
        </destination>
    </destinations>
</job_conf>
EOL
)

# Generate Galaxy configuration file
(
umask 077
cat > "${GALAXY_CONFIG_FILE}" << EOL
gravity:
  galaxy_user : ${USER}
  gunicorn:
    enable: true
    preload: true
    bind: 0.0.0.0:${port}
  celery:
    loglevel: INFO

galaxy:
  data_dir: ${DATAROOT}
  galaxy_url_prefix: /node/${HOSTNAME}/${port}
  static_enabled: true
  static_dir: ${GALAXY_ROOT_DIR}/static/
  use_remote_user: true
  remote_user_header: HTTP_X_FORWARDED_USER
  dynamic_proxy_manage: false
  real_system_username: user
  tool_dependency_dir: ${DATAROOT}/dependencies
  library_import_dir: ${DATAROOT}/import-dir/
  user_library_import_symlink_allowlist: /bigdata,/rhome
  allow_path_paste: true
  webhooks_dir: ${WEBHOOKS_DIR}
  config_dir: ${GALAXY_ROOT_DIR}/config
  managed_config_dir: ${DATAROOT}/config
  integrated_tool_panel_config: ${DATAROOT}/config/integrated_tool_panel.xml
  shed_tool_data_path: ${DATAROOT}/shed_tool_data
  shed_tool_config_file: ${DATAROOT}/config/shed_tool_conf.xml
  tool_config_file: ${GALAXY_ROOT_DIR}/lib/galaxy/config/sample/tool_conf.xml.sample,${PWD}/hpcc_tools.xml,${GALAXY_ROOT_DIR}/bootstrap/config/bootstrap_tools_conf.xml
  tool_path: ${GALAXY_ROOT_DIR}/tools
  tool_data_path: ${DATAROOT}/shed_tool_data
  install_database_connection: "sqlite:///${DATAROOT}/install_tool_sheds.sqlite"
  admin_users: ${USER}@ucr.edu
  log_level: INFO
  job_config_file: ${PWD}/job_conf.xml
  simplified_workflow_run_ui: off
  database_auto_migrate: true
  dependency_resolvers:
    - type: conda
      auto_init: false
      auto_install: false
      prefix: ${GALAXY_ROOT_DIR}/bootstrap/dependencies/_conda/
      exec: ${GALAXY_ROOT_DIR}/bootstrap/dependencies/_conda/bin/conda
      read_only: true
    - type: conda
      auto_init: true
      auto_install: false
      prefix: ${DATAROOT}/dependencies/_conda
      exec: ${DATAROOT}/dependencies/_conda/bin/conda
    - type: modules
      versionless: true
      modulecmd: $(which modulecmd)
      find_by: avail
      default_indicator: "(default)"
EOL
)

# Creates galaxy directory and sets directory permissions
if [ ! -d "${DATAROOT}" ]; then
  echo "Creating galaxy directory..."
  mkdir -p ${DATAROOT}/dependencies \
    ${DATAROOT}/config \
    ${DATAROOT}/import-dir \
    ${DATAROOT}/shed_tool_data
  cp ${GALAXY_ROOT_DIR}/bootstrap/install_tool_sheds.sqlite ${DATAROOT}/
  cp ${GALAXY_ROOT_DIR}/bootstrap/workflow_sqlite_data.out ${DATAROOT}/
  cp ${GALAXY_ROOT_DIR}/bootstrap/config/bootstrap_tools_conf.xml \
     ${GALAXY_ROOT_DIR}/bootstrap/config/shed_tool_data_table_conf.xml \
     ${GALAXY_ROOT_DIR}/bootstrap/config/shed_data_manager_conf.xml \
     ${GALAXY_ROOT_DIR}/bootstrap/config/integrated_tool_panel.xml \
     ${DATAROOT}/config/
  cp -r ${GALAXY_ROOT_DIR}/bootstrap/workflows ${DATAROOT}
  ln -s /rhome/$USER ${DATAROOT}/import-dir/$USER
  source ${GALAXY_ROOT_DIR}/.venv/bin/activate
  python $GALAXY_ROOT_DIR/scripts/db.py -c ${GALAXY_CONFIG_FILE} init
  sqlite3 ${DATAROOT}/universe.sqlite < ${DATAROOT}/workflow_sqlite_data.out
  rm ${DATAROOT}/workflow_sqlite_data.out
  chmod 770 ${DATAROOT}
fi

